name: Auto Update README

on:
  schedule:
    - cron: '0 0 * * 1' # Executa toda segunda-feira à meia-noite
  workflow_dispatch: # Permite execução manual
  push:
    branches:
      - main
    paths:
      - '.github/workflows/update-readme.yml'

jobs:
  update-readme:
    runs-on: ubuntu-latest
    permissions:
      contents: write
      pull-requests: write
    
    steps:
    - name: Checkout repository
      uses: actions/checkout@v4
      with:
        fetch-depth: 0
    
    - name: Setup Node.js
      uses: actions/setup-node@v4
      with:
        node-version: '18'
    
    - name: Get GitHub Stats
      id: github-stats
      run: |
        # Get repository info
        REPO_INFO=$(curl -s -H "Authorization: token ${{ secrets.GITHUB_TOKEN }}" \
          "https://api.github.com/repos/${{ github.repository }}")
        
        # Get user info
        USER_INFO=$(curl -s -H "Authorization: token ${{ secrets.GITHUB_TOKEN }}" \
          "https://api.github.com/users/Felps-26")
        
        # Get latest commits
        COMMITS_INFO=$(curl -s -H "Authorization: token ${{ secrets.GITHUB_TOKEN }}" \
          "https://api.github.com/repos/${{ github.repository }}/commits?per_page=5")
        
        # Extract data
        TOTAL_COMMITS=$(echo "$COMMITS_INFO" | jq length)
        LAST_COMMIT_DATE=$(echo "$COMMITS_INFO" | jq -r '.[0].commit.author.date' | cut -d'T' -f1)
        PUBLIC_REPOS=$(echo "$USER_INFO" | jq '.public_repos')
        FOLLOWERS=$(echo "$USER_INFO" | jq '.followers')
        FOLLOWING=$(echo "$USER_INFO" | jq '.following')
        
        # Set outputs
        echo "total_commits=$TOTAL_COMMITS" >> $GITHUB_OUTPUT
        echo "last_commit_date=$LAST_COMMIT_DATE" >> $GITHUB_OUTPUT
        echo "public_repos=$PUBLIC_REPOS" >> $GITHUB_OUTPUT
        echo "followers=$FOLLOWERS" >> $GITHUB_OUTPUT
        echo "following=$FOLLOWING" >> $GITHUB_OUTPUT
        
        # Get current date
        echo "current_date=$(date +'%Y-%m-%d')" >> $GITHUB_OUTPUT
        echo "current_time=$(date +'%H:%M:%S UTC')" >> $GITHUB_OUTPUT
    
    - name: Update README with dynamic content
      run: |
        # Create updated README content
        cat > README.md << 'EOF'
        <h1 align="center">
          <a href="https://git.io/typing-svg">
            <img src="https://readme-typing-svg.herokuapp.com/?lines=Hello,+World!+👋;I'm+Felps_!;Welcome+to+my+GitHub!&center=true&size=30" alt="Typing SVG" />
          </a>
        </h1>
        
        ## 🧑‍💻 About Me
        
        • 🔭 I'm currently working on Data Structures & Algorithms and Object-Oriented Programming  
        • 🌱 I'm currently learning C Programming, Frontend Development, and SQL  
        • 💡 Always exploring new technologies and programming concepts  
        • 📚 Computer Science student passionate about software development  
        • 🎯 Goal: Build efficient and innovative software solutions  
        
        ## 📊 Dynamic Stats (Auto-Updated)
        
        - 📈 **Total Repositories:** ${{ steps.github-stats.outputs.public_repos }}  
        - 👥 **Followers:** ${{ steps.github-stats.outputs.followers }}  
        - 👤 **Following:** ${{ steps.github-stats.outputs.following }}  
        - 🗓️ **Last Profile Update:** ${{ steps.github-stats.outputs.current_date }}  
        - ⏰ **Last Automated Update:** ${{ steps.github-stats.outputs.current_time }}  
        
        ## 🛠️ Tech Stack & Tools
        
